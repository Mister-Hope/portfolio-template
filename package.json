{
  "name": "portfolio-template",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Mister-Hope"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mister-Hope/portfolio-template.git"
  },
  "type": "module",
  "imports": {
    "#helper": "./src/helper.ts",
    "#types": "./src/types/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "clean": "rimraf dist",
    "dev": "vite",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@iconify/react": "^6.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@mdit/helper": "1.1.3",
    "@mr-hope/tsconfig": "0.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "^8.20.0",
    "js-yaml": "5.5.0",
    "markdown-it": "^15.0.3",
    "oxc-config-hope": "0.3.15",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2006",
    "rimraf": "6.1.4",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "unrun": "0.3.1",
    "vite": "8.3.6",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.23.4 || ^24.22.1 || ^26.13.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.16.1"
}

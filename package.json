{
  "name": "portfolio-template",
  "version": "0.0.0",
  "private": true,
  "author": {
    "name": "Mister-Hope"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mister-Hope/portfolio-template.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "clean": "rimraf dist",
    "dev": "vite",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@mdit/helper": "1.1.2",
    "@mr-hope/tsconfig": "0.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "js-yaml": "5.4.2",
    "markdown-it": "^15.0.2",
    "nano-staged": "^1.0.2",
    "oxc-config-hope": "0.3.15",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "unrun": "^0.3.1",
    "vite": "^8.3.1"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts}": "oxlint --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.0.0 || ^26.0.0",
      "onFail": "error"
    }
  }
}
